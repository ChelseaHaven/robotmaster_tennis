{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "配置 Release",
            "type": "process",
            "command": "${env:LOCALAPPDATA}/stm32cube/bundles/cmake/4.4.0+st.1/bin/cmake.exe",
            "args": [
                "--preset",
                "Release"
            ],
            "problemMatcher": []
        },
        {
            "label": "编译 Release",
            "type": "process",
            "command": "${env:LOCALAPPDATA}/stm32cube/bundles/cmake/4.4.0+st.1/bin/cmake.exe",
            "args": [
                "--build",
                "--preset",
                "Release",
                "--parallel"
            ],
            "dependsOn": "配置 Release",
            "problemMatcher": "$gcc"
        },
        {
            "label": "烧录",
            "type": "process",
            "command": "${env:LOCALAPPDATA}/stm32cube/bundles/programmer/2.23.0/bin/STM32_Programmer_CLI.exe",
            "args": [
                "-c",
                "port=SWD",
                "freq=4000",
                "-w",
                "robotmaster_c_tennis.elf",
                "-v",
                "-rst"
            ],
            "options": {
                "cwd": "${workspaceFolder}/build/Release"
            },
            "problemMatcher": [],
            "dependsOn": "编译 Release"
        }
    ],
    "options": {
        "cwd": "${workspaceFolder}",
        "env": {
            "PATH": "${env:LOCALAPPDATA}/stm32cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin;${env:LOCALAPPDATA}/stm32cube/bundles/ninja/1.13.2+st.1/bin;${env:PATH}"
        }
    }
}
